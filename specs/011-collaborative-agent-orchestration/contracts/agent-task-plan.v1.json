{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-task-plan.v1.json",
  "title": "AgentTaskPlanProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objective", "steps"],
  "properties": {
    "schema_version": {"const": "agent-task-plan.v1"},
    "objective": {"type": "string", "maxLength": 500},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_key", "title", "responsibility", "tool_name", "operation_type",
          "arguments", "depends_on", "input_source", "expected_output",
          "requires_confirmation"
        ],
        "properties": {
          "step_key": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "responsibility": {"type": "string", "minLength": 1, "maxLength": 300},
          "tool_name": {"type": "string", "minLength": 1, "maxLength": 160},
          "operation_type": {
            "enum": ["query", "analyze", "create", "update", "delete", "publish", "rollback", "external_effect"]
          },
          "arguments": {"type": "object"},
          "depends_on": {
            "type": "array",
            "maxItems": 11,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"}
          },
          "input_source": {"enum": ["current_message", "conversation_context", "dependency"]},
          "expected_output": {"type": "string", "minLength": 1, "maxLength": 300},
          "requires_confirmation": {"type": "boolean"}
        }
      }
    }
  }
}

