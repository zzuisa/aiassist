{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-result.v1.json",
  "title": "VerificationResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "step_key", "totals", "items", "generated_at"],
  "properties": {
    "schema_version": {"const": "verification-result.v1"},
    "plan_id": {"type": "string", "format": "uuid"},
    "step_key": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "mismatch", "not_found", "unauthorized", "provider_error", "unverifiable"],
      "properties": {
        "verified": {"type": "integer", "minimum": 0},
        "mismatch": {"type": "integer", "minimum": 0},
        "not_found": {"type": "integer", "minimum": 0},
        "unauthorized": {"type": "integer", "minimum": 0},
        "provider_error": {"type": "integer", "minimum": 0},
        "unverifiable": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "expected_state", "observed_state_digest", "status", "checked_at"],
        "properties": {
          "object_id": {"type": "string", "maxLength": 160},
          "expected_state": {"type": "object"},
          "observed_state_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["verified", "mismatch", "not_found", "unauthorized", "provider_error", "unverifiable"]},
          "safe_reason": {"type": ["string", "null"], "maxLength": 500},
          "checked_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
