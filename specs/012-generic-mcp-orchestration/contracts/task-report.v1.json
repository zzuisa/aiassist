{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-report.v1.json",
  "title": "AgentTaskReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "plan_id", "revision", "source_digest", "objective",
    "executed_steps", "totals", "verified_changes", "conflicts", "failures", "skipped",
    "unprocessed", "next_actions", "markdown", "report_digest", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "task-report.v1"},
    "report_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objective": {"type": "string", "maxLength": 500},
    "executed_steps": {"type": "array", "maxItems": 12, "items": {"type": "object"}},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "processed", "applied", "verified", "conflicted", "failed", "skipped", "unprocessed", "manual_review"],
      "properties": {
        "matched": {"type": "integer", "minimum": 0},
        "processed": {"type": "integer", "minimum": 0},
        "applied": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "conflicted": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "unprocessed": {"type": "integer", "minimum": 0},
        "manual_review": {"type": "integer", "minimum": 0}
      }
    },
    "verified_changes": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "conflicts": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "failures": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "skipped": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "unprocessed": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "next_actions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
    "markdown": {"type": "string", "maxLength": 200000},
    "report_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_method": {"enum": ["deterministic", "llm_enhanced"]},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
