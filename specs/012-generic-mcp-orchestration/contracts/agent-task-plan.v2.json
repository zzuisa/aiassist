{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-task-plan.v2.json",
  "title": "AgentTaskPlanProposalV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_snapshot_id", "objective", "steps"],
  "properties": {
    "schema_version": {"const": "agent-task-plan.v2"},
    "capability_snapshot_id": {"type": "string", "format": "uuid"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_key", "title", "responsibility", "kind", "capability_name", "arguments",
          "depends_on", "input_bindings", "output_contract", "scope_policy", "batch_policy",
          "failure_policy", "requires_confirmation"
        ],
        "properties": {
          "step_key": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "responsibility": {"type": "string", "minLength": 1, "maxLength": 300},
          "kind": {"enum": ["select", "map", "filter", "aggregate", "analyze", "mutate", "verify", "report"]},
          "capability_name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "arguments": {"type": "object", "maxProperties": 50},
          "depends_on": {
            "type": "array",
            "maxItems": 11,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"}
          },
          "input_bindings": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_step", "artifact_type", "contract"],
              "properties": {
                "from_step": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"},
                "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
                "contract": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
                "pointer": {"type": "string", "pattern": "^(/([A-Za-z0-9_-]+))*$", "maxLength": 200}
              }
            }
          },
          "output_contract": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
          "scope_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_type", "may_expand"],
            "properties": {
              "object_type": {"type": ["string", "null"], "maxLength": 40},
              "may_expand": {"type": "boolean"}
            }
          },
          "batch_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_items", "page_size", "max_concurrency"],
            "properties": {
              "max_items": {"type": "integer", "minimum": 1, "maximum": 1000},
              "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
              "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4}
            }
          },
          "failure_policy": {"enum": ["block_dependents", "continue_partial", "always_finalize"]},
          "requires_confirmation": {"type": "boolean"}
        }
      }
    }
  }
}
