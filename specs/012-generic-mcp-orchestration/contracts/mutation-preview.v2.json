{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutation-preview.v2.json",
  "title": "MutationPreviewV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "preview_id", "preview_version", "preview_digest", "plan_id",
    "step_key", "capability_snapshot_id", "summary", "items", "excluded", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "mutation-preview.v2"},
    "preview_id": {"type": "string", "format": "uuid"},
    "preview_version": {"type": "integer", "minimum": 1},
    "preview_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_id": {"type": "string", "format": "uuid"},
    "step_key": {"type": "string", "pattern": "^step_[a-z0-9_]{1,48}$"},
    "capability_snapshot_id": {"type": "string", "format": "uuid"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected", "low_confidence", "excluded"],
      "properties": {
        "affected": {"type": "integer", "minimum": 0, "maximum": 1000},
        "low_confidence": {"type": "integer", "minimum": 0, "maximum": 1000},
        "excluded": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_type", "object_id", "object_title", "expected_version", "current_value",
          "proposed_value", "confidence", "reason", "risk"
        ],
        "properties": {
          "object_type": {"type": "string", "maxLength": 40},
          "object_id": {"type": "string", "maxLength": 160},
          "object_title": {"type": "string", "maxLength": 240},
          "expected_version": {"type": "integer", "minimum": 1},
          "current_value": {},
          "proposed_value": {},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "maxLength": 500},
          "risk": {"type": "object", "maxProperties": 20}
        }
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "reason_code"],
        "properties": {
          "object_id": {"type": "string", "maxLength": 160},
          "reason_code": {"type": "string", "maxLength": 64},
          "reason": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
